# Azure ML Startup GPU Cluster config. Distinct from config.env (which
# targets a standalone az-vm-create A100 spot VM per SPEC.md's original
# locked-compute plan). This one targets the Microsoft for Startups GPU
# Cluster reservation: access via an Azure ML Compute Instance (SSH-enabled,
# behaves like a normal VM once up), not a raw Microsoft.Compute VM.
#
# Reservation: 8x NDm A100 v4 (Standard_ND96amsr_A100_v4), Italy North,
# 2026-08-21 (morning PT) - 2026-08-23. Quota is requested via an Azure
# support ticket on the start date (Quota type: Azure Machine Learning,
# NOT Compute) then granted a few hours later -- see MfSDepthOps email.

export AZURE_SUBSCRIPTION_ID="<set in the untracked .env, see docs>"

export AML_RESOURCE_GROUP=scfx-italynorth
export AML_WORKSPACE=scfx-ws-italynorth
export AML_LOCATION=italynorth
export AML_VM_SIZE=Standard_ND96amsr_A100_v4
export AML_COMPUTE_NAME=scfx-compute

export AML_SSH_PUB_KEY_PATH="$HOME/.ssh/scfx_italynorth_rsa.pub"
export AML_SSH_PRIVATE_KEY_PATH="$HOME/.ssh/scfx_italynorth_rsa"
export AML_ADMIN_USER=azureuser  # AML compute instance SSH user is fixed regardless of what's requested

# Reservation hard end date (Microsoft's policy: spin down by the agreed end
# date or risk extra charges). NOT the generic SPEC.md 8h-since-launch
# autokill -- this run must stay up close to the full ~48h window, not
# deallocate after 8h. autokill.sh / controller.py should respect whichever
# of {8h-since-launch, this end date} comes first, but this end date is the
# one that actually matters for this booking.
export AML_RESERVATION_END_UTC="2026-08-23T20:00:00Z"  # ~end of day Aug 23; tighten once exact cutoff is confirmed

# /mnt, NOT /home -- the OS disk (~119GB) is shared by all 3 coordinated
# experiments' code+venvs+outputs and already hit 100% once (2026-08-21).
# /mnt is a much larger, separate disk (2.8TB on this box). Also distinctly
# namespaced (not the obvious "shortcut_forensics"): an independent earlier
# session already collided on that exact name.
export REMOTE_DIR="/mnt/scfx_ly_run"
export VM_DATA_DISK_OUTPUTS_DIR="/mnt/scfx_ly_data_mirror/outputs"

# Cloud-native backup, independent of laptop uptime and of whether this
# compute instance has a real separate data disk (AML compute instances
# often don't -- unlike the raw-VM path's explicit --data-disk-sizes-gb).
# This storage account already exists (auto-provisioned with the AML
# workspace); we're just adding a container to it.
export AML_STORAGE_ACCOUNT=scfxwsitstorage7a947b9ea
export AML_BACKUP_CONTAINER=outputs-backup

# The OS disk (/, ~119GB) filled to 100% within minutes of model downloads
# starting -- 3 experiments sharing one box, each pulling multi-GB model
# weights into the default ~/.cache/huggingface. AML compute instances have
# a much larger local disk mounted separately (found empirically: /dev/sdb1
# at /mnt, 2.8TB, <3% used) -- route the HF cache there, not root.
export HF_CACHE_DIR="/mnt/scfx_ly_cache"
