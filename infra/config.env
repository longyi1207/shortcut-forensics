# Azure GPU VM config. Sourced by launch.sh / bootstrap.sh / pull.sh / autokill.sh.
# Credentials come from repo-root .env (docs/AZURE.md) — this file is non-secret.

export AZURE_SUBSCRIPTION_ID="<set in the untracked .env, see docs>"
export AZURE_RESOURCE_GROUP=IncidentFox
export AZURE_LOCATION=eastus
export AZURE_LOCATION_FALLBACK=westus2

export AZURE_VM_SIZE=Standard_NC24ads_A100_v4
export AZURE_VM_IMAGE="microsoft-dsvm:ubuntu-hpc:2204:latest"  # ships NVIDIA driver + CUDA pre-installed
export AZURE_VM_ADMIN_USER=azureuser
export AZURE_SSH_PUB_KEY_PATH="$HOME/.ssh/id_rsa.pub"

export AZURE_USE_SPOT=1
export AZURE_SPOT_MAX_PRICE=-1  # -1 = pay up to the current PAYG price, never evict on price alone
export AZURE_EVICTION_POLICY=Deallocate

export MAX_HOURS=8
export REMOTE_DIR="/home/${AZURE_VM_ADMIN_USER:-azureuser}/shortcut_forensics"
export VM_DATA_DISK_OUTPUTS_DIR="/data/shortcut_forensics/outputs"
